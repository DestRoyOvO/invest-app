# Copy to .env.local and fill in. Never commit .env.local.
# Blank values mean "use the default". The server checks these at startup and logs one line per problem;
# docs/deployment.md describes every setting.

# --- AI (DeepSeek) ---

# DeepSeek API key. Required for the AI research notes and chat.
DEEPSEEK_API_KEY=

# Optional model override (default: deepseek-chat).
DEEPSEEK_MODEL=deepseek-chat

# Optional API base URL (default: https://api.deepseek.com). Must be https; plain http is accepted only for localhost,
# so tests can point the app at a local mock server.
DEEPSEEK_BASE_URL=

# Maximum AI requests per day for one server process (default 200). DeepSeek's prepaid balance stays the hard cap.
AI_DAILY_LIMIT=200

# --- Access ---

# Password that unlocks the AI features (and the whole site when SITE_ACCESS=private). Use 12 to 256 characters.
# Production (next start, Docker, Vercel): required for AI, otherwise the AI endpoints stay disabled.
# Development (npm run dev): optional; without it AI is open, and the dev server only listens on 127.0.0.1.
ACCESS_PASSWORD=

# Secret used to sign the session cookie (required with ACCESS_PASSWORD). Use 32+ random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A production server refuses to start when ACCESS_PASSWORD is set without a valid SESSION_SECRET.
SESSION_SECRET=

# public (default): market pages and data are open to anyone who can reach the server; only AI needs the password.
# private: every page and API asks for the password first (except /api/health). Recommended for a personal
# deployment on a public address. Needs ACCESS_PASSWORD and SESSION_SECRET.
SITE_ACCESS=

# --- Network ---

# Set to 1 when self-hosting behind your own reverse proxy (nginx, Caddy...) that appends the client address to
# X-Forwarded-For. Rate limits then use that address. Leave unset otherwise: forwarded headers are ignored and all
# clients share one rate-limit bucket. Not needed on Vercel, where the platform sets the client address.
# Docker Compose sets 1 for the app and ignores this line; to change it there, set TRUST_PROXY in the shell or in a
# .env file next to docker-compose.yml.
TRUST_PROXY=

# Public address of the deployment, e.g. https://invest.example.com (optional; used for absolute links).
SITE_URL=

# --- Operations ---

# Server log level: debug, info (default), warn, error or silent. Logs are one JSON object per line.
LOG_LEVEL=

# Where market data comes from: yahoo (default). fixtures and record are reserved for the upcoming replay mode of the
# end-to-end tests and are not available yet.
MARKET_DATA_SOURCE=
